{
  "name": "nextgen-mentorship-platform",
  "version": "0.1.0-staging.1",
  "private": true,
  "description": "Independent, add-on based NextGen mentorship platform staging release.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @nextgen/api --filter @nextgen/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @nextgen/api prisma:generate",
    "db:migrate": "pnpm --filter @nextgen/api prisma:migrate",
    "db:deploy": "pnpm --filter @nextgen/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @nextgen/api prisma:seed",
    "db:reset-admin": "pnpm --filter @nextgen/api prisma:reset-admin",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
