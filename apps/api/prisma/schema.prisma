  relationships              MentorshipRelationship[]
  serviceHours               MentorshipServiceHour[]
  stipendDecisions           MentorshipStipendDecision[]

  @@unique([programId, code])
  @@index([programId])
  @@index([status])
  @@index([programStartDate, programEndDate])
}

