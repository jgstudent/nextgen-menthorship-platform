  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  submission          DocumentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user                User?              @relation("SubmissionSignerUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([docusealSubmitterId])
}

model ApprovalComment {
  id         String   @id @default(cuid())
  approvalId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@index([authorId])
}

model ApprovalHistory {
  id             String          @id @default(cuid())
  approvalId     String
  action         ApprovalAction
  actorId        String
  previousStatus ApprovalStatus?
  newStatus      ApprovalStatus?
  notes          String?
  timestamp      DateTime        @default(now())
  approval       Approval        @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actor          User            @relation("ApprovalHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@index([actorId])
  @@index([timestamp])
}

model Meeting {
  id             String              @id @default(cuid())
  organizationId String
  workspaceId    String?
  projectId      String?
  title          String
  description    String?
  location       String?
  videoUrl       String?
  startTime      DateTime
  endTime        DateTime
  status         MeetingStatus       @default(SCHEDULED)
  agenda         String?
  notes          String?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  attendees      MeetingAttendee[]
  actionItems    MeetingActionItem[]
  documents      Document[]
  resolutions    BoardResolution[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([createdById])
  @@index([startTime])
}

model MeetingAttendee {
  id             String                @id @default(cuid())
  meetingId      String
  userId         String
  role           MeetingAttendeeRole   @default(REQUIRED)
  responseStatus MeetingResponseStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  meeting        Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

model MeetingActionItem {
  id              String                  @id @default(cuid())
  meetingId       String
  title           String
  description     String?
  assignedToId    String?
  dueDate         DateTime?
  status          MeetingActionItemStatus @default(OPEN)
  convertedTaskId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  meeting         Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignedTo      User?                   @relation("MeetingActionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedTask   Item?                   @relation("ConvertedMeetingTask", fields: [convertedTaskId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([assignedToId])
  @@index([convertedTaskId])
}
